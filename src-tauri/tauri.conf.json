{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenguX11VNC",
  "version": "0.1.1",
  "identifier": "com.pengux11vnc.app",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../server.js",
      "../config.js",
      "../ime-bridge.js",
      "../public/**/*",
      "../tools/**/*",
      "../runtime/node/**/*",
      "../node_modules/@novnc/novnc/**/*",
      "../node_modules/ws/**/*"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
